module Top
    submodule core : Core
    submodule instruction_memory : Memory
    submodule data_memory : Memory
    net instruction_request : capacity 1 width 9
    net instruction_response : capacity 1 width 5
    net data_request : capacity 1 width 9
    net data_response : capacity 1 width 5
    core.instruction_request => instruction_request
    instruction_memory.request <= instruction_request
    instruction_memory.response => instruction_response
    core.instruction_response <= instruction_response
    core.data_request => data_request
    data_memory.request <= data_request
    data_memory.response => data_response
    core.data_response <= data_response
    init $
        core.instruction_cache.CACHE_DELAY = 0;
        core.data_cache.CACHE_DELAY = 0;
        instruction_memory.MEM_DELAY = 0;
        data_memory.MEM_DELAY = 0;
    $
end module

module Core
    outport instruction_request : width 9
    inport instruction_response : width 5
    outport data_request : width 9
    inport data_response : width 5
    procedure processor : Processor
    procedure instruction_cache : Cache<>
    procedure data_cache : Cache<>
    init $
        instruction_cache.memory_request = &instruction_request;
        instruction_cache.memory_response = &instruction_response;
        data_cache.memory_request = &data_request;
        data_cache.memory_response = &data_response;
        processor.instruction_cache = &instruction_cache;
        processor.data_cache = &data_cache;
    $
    behavior
        [run processor; || run instruction_cache; || run data_cache;];
    end behavior
end module

procedure Cache
    parameter int NUM_SETS = 2
    parameter int NUM_WAYS = 2
    parameter int BLOCK_SIZE = 16
    include $
        #include <cassert>
        #include <stdexcept>
        #include <random>
    $
    decl $
        int CACHE_DELAY = 0;
        outport<9>* memory_request = nullptr;
        inport<5>* memory_response = nullptr;
        uint64_t request_id = 0, response_id = 0;
        uint32_t address = 0, write_data = 0, read_data = 0;
        uint8_t write = 0, error = 0;
        uint64_t start_time = 0, finish_time = 0, hits = 0, misses = 0;
        static_assert(NUM_SETS > 0 && !(NUM_SETS & (NUM_SETS-1)), "Invalid set count");
        static_assert(NUM_WAYS > 0 && !(NUM_WAYS & (NUM_WAYS-1)), "Invalid way count");
        static_assert(BLOCK_SIZE >= 4 && BLOCK_SIZE <= 256 && !(BLOCK_SIZE & (BLOCK_SIZE-1)), "Invalid block size");
        bool valid[NUM_SETS][NUM_WAYS] = {};
        uint32_t tags[NUM_SETS][NUM_WAYS] = {};
        uint8_t values[NUM_SETS][NUM_WAYS][BLOCK_SIZE] = {};
        std::mt19937 generator{1};
        uint32_t saved_address, saved_data, tag, base;
        uint8_t saved_write;
        uint64_t active_id;
        int slot, way, offset, position;
        void save_word(int pos, uint32_t value) {
            for (int i=0; i<4; i++) values[slot][way][pos+i] = value >> (24-8*i);
        }
        uint32_t load_word() {
            uint32_t value = 0;
            for (int i=0; i<4; i++) value = (value << 8) | values[slot][way][offset+i];
            return value;
        }
        bool hit, sent;
        token<9> request_token;
        token<5> response_token;
    $
    behavior
        $if (CACHE_DELAY < 0 || !memory_request || !memory_response)
            throw std::runtime_error("Invalid cache configuration");$;
        do
            wait until (request_id > response_id);
            $
            assert(request_id == response_id + 1);
            active_id = request_id;
            saved_address = address; saved_data = write_data; saved_write = write;
            start_time = current_time.toUint64();
            error = saved_write > 1 ? 3 : saved_address % 4 ? 2 : saved_address > 252 ? 1 : 0;
            base = saved_address / BLOCK_SIZE * BLOCK_SIZE;
            offset = saved_address % BLOCK_SIZE;
            slot = (saved_address / BLOCK_SIZE) % NUM_SETS;
            tag = saved_address / BLOCK_SIZE / NUM_SETS;
            way = -1;
            for (int i=0; i<NUM_WAYS; i++)
                if (valid[slot][i] && tags[slot][i] == tag) way = i;
            hit = !error && way >= 0;
            if (!error && !hit) {
                for (int i=0; i<NUM_WAYS; i++)
                    if (!valid[slot][i]) { way=i; break; }
                if (way < 0) way = std::uniform_int_distribution<int>(0, NUM_WAYS-1)(generator);
                valid[slot][way] = false;
            }
            read_data = 0;
            if (!error) { if (hit) hits++; else misses++; }
            $;
            wait(CACHE_DELAY,0);
            if (not error) then
                if (saved_write) then
                    $sitar::pack(request_token, saved_write, saved_address, saved_data); sent=false;$;
                    do
                        wait until (this_phase == 1);
                        $sent = memory_request->push(request_token);$;
                        if (not sent) then wait; end if;
                    while (not sent) end do;
                    wait until (this_phase == 0 and $memory_response->peek(response_token)$);
                    $memory_response->pull(response_token); sitar::unpack(response_token, error, read_data);$;
                    if (not error and hit) then $save_word(offset, read_data);$; end if;
                end if;
                if (not error and not hit) then
                    $position=0;$;
                    do
                        $sitar::pack(request_token, uint8_t(0), uint32_t(base+position), uint32_t(0)); sent=false;$;
                        do
                            wait until (this_phase == 1);
                            $sent = memory_request->push(request_token);$;
                            if (not sent) then wait; end if;
                        while (not sent) end do;
                        wait until (this_phase == 0 and $memory_response->peek(response_token)$);
                        $memory_response->pull(response_token); sitar::unpack(response_token, error, read_data);
                        if (!error) save_word(position, read_data);
                        position+=4;$;
                    while (not error and position < BLOCK_SIZE) end do;
                    $if (!error) { valid[slot][way]=true; tags[slot][way]=tag; }$;
                end if;
                $read_data = error ? 0 : load_word();$;
            end if;
            $
            finish_time = current_time.toUint64();
            response_id = active_id;
            log << endl << "ACCESS id=" << response_id << " address=" << saved_address
                << " hit=" << hit << " write=" << int(saved_write)
                << " error=" << int(error) << " ticks=" << finish_time-start_time;
            $;
        while (1) end do;
    end behavior
end procedure

procedure Processor
    include $
        #include "Cache.h"
        #include <algorithm>
    $
    decl $
        Cache<>* instruction_cache = nullptr;
        Cache<>* data_cache = nullptr;
        const uint32_t addresses[20] = {0,4,0,0,64,0,256,2,128,192,0,64,128,192,0,64,128,192,0,4};
        int index = 0;
        uint64_t issue_time;
        void submit(Cache<>* cache, bool store) {
            assert(cache->request_id == cache->response_id);
            cache->address = addresses[index];
            cache->write = store;
            cache->write_data = 777;
            cache->request_id++;
        }
        void check(Cache<>* cache, bool data_path) {
            uint8_t expected_error = index == 6 ? 1 : index == 7 ? 2 : 0;
            uint32_t expected_data = expected_error ? 0 :
                data_path && index >= 2 && addresses[index] == 0 ? 777 : addresses[index]/4;
            assert(cache->response_id == uint64_t(index+1));
            assert(cache->hits + cache->misses == uint64_t(index+1 - (index >= 6) - (index >= 7)));
            if (index == 1 && sizeof(cache->values[0][0]) >= 8) assert(cache->hit);
            if (index == 3) assert(cache->hit);
            assert(cache->start_time == issue_time);
            assert(cache->error == expected_error && cache->read_data == expected_data);
            if (!expected_error && cache->hit && !cache->write)
                assert(cache->finish_time-issue_time == uint64_t(2*cache->CACHE_DELAY));
        }
    $
    behavior
        do
            $
            issue_time = current_time.toUint64();
            submit(instruction_cache, false);
            submit(data_cache, index == 2);
            $;
            [
                wait until ($instruction_cache->response_id == instruction_cache->request_id$);
                $check(instruction_cache, false);$;
            ||
                wait until ($data_cache->response_id == data_cache->request_id$);
                $check(data_cache, true);$;
            ];
            $
            assert(current_time.toUint64() == std::max(instruction_cache->finish_time, data_cache->finish_time));
            log << endl << "PAIR index=" << index << " start=" << time(issue_time)
                << " finish=" << current_time;
            index++;
            $;
        while (index < 20) end do;
        $log << endl << "PASS requests_per_cache=" << index
            << " hits=" << instruction_cache->hits << " misses=" << instruction_cache->misses
            << " data_hits=" << data_cache->hits << " data_misses=" << data_cache->misses
            << " finish=" << current_time;$;
        stop simulation;
    end behavior
end procedure

// Write-through memory: a store response acknowledges the value actually written.
module Memory
    inport request : width 9
    outport response : width 5
    include $#include <stdexcept>$
    decl $
        int MEM_DELAY = 0;
        uint32_t words[64], address, value;
        uint8_t write, error;
        bool sent;
        token<9> request_token;
        token<5> response_token;
    $
    init $for (int i=0; i<64; i++) words[i]=i;$
    behavior
        $if (MEM_DELAY < 0) throw std::runtime_error("Negative memory delay");$;
        do
            wait until (this_phase == 0 and $request.peek(request_token)$);
            $request.pull(request_token); sitar::unpack(request_token, write, address, value);$;
            wait(MEM_DELAY,0);
            $
            error = write > 1 ? 3 : address % 4 ? 2 : address > 252 ? 1 : 0;
            if (!error) {
                if (write) words[address/4]=value;
                value=words[address/4];
            } else value=0;
            sitar::pack(response_token, error, value); sent=false;
            $;
            do
                wait until (this_phase == 1);
                $sent=response.push(response_token);$;
                if (not sent) then wait; end if;
            while (not sent) end do;
        while (1) end do;
    end behavior
end module
