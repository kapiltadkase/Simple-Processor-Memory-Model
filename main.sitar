module Top
    submodule sys : System

    // ---- Non-structural parameters, seeped down from Top ----
    init $
        sys.proc.EXECUTION_DELAY = 5;
        sys.proc.P_LOAD          = 40;   // percent
        sys.proc.P_STORE         = 30;   // percent
        sys.proc.NUM_INSTR       = 10;
        sys.mem.DELAY            = 3;
        sys.proc.MAX_TIME        = 1000;   // Question 3 addition
    $
end module


module System
    submodule proc : Processor
    submodule mem  : Cache<1024, 80, 2, 20>       // structural param: size, p_hit, delay_hit, delay_miss

    net n_request  : capacity 1 width 22   // Processor -> Memory
    net n_response : capacity 1 width 17   // Memory -> Processor

    proc.req_port  => n_request
    mem.req_port   <= n_request
    mem.resp_port  => n_response
    proc.resp_port <= n_response
end module


// Processor ----------------------------------------------------
module Processor
    outport req_port  : width 22
    inport  resp_port : width 17

    

    include $#include <cstdlib>$
    include $#include <cstdint>$
    include $#include <iomanip>$

    decl $
        // ---- configuration (defaults here; overridden from Top's init) ----
        int EXECUTION_DELAY = 5;
        int P_LOAD           = 40;
        int P_STORE          = 30;
        int NUM_INSTR        = 10;
        int MAX_TIME         = 1000;         // question 3 addition

        // ---- encodings (shared conceptually with Memory; replicated here

        enum AccessType { IFETCH = 0, LOAD = 1, STORE = 2, ATOMICLOADSTORE = 3 };
        enum SizeSpec   { WORD = 0, DOUBLEWORD = 1, QUADWORD = 2 };

        // ---- loop state ----
        int pc;                // program counter
        int instr_count;       

        // Request assembly variable
        uint32_t req_addr;              // 32 bit address
        uint8_t  req_type;              // 8 bit request type
        uint8_t  req_size;              // 8 bit size
        uint8_t  req_data[16];          //An array of 16 bytes (128 bits) used to hold the actual data if the processor is doing a STORE. (16 bytes is the max size of a QUADWORD).

        // Response assembly variable
        uint8_t  resp_error;            // 8 bit error status
        uint8_t  resp_data[16];         // An array of 16 bytes that catches the data coming back from memory during an IFETCH or LOAD.

        token<22> req_tok;              // 4 (address) + 1 (type) + 1 (size) + 16 (data) = 22 bytes
        token<17> resp_tok;             // 1 (error) + 16 (data) = 17 bytes

        bool ok;                       //bool flag to keep a tab on whether token was successfully pushed in n_request net
        bool pulled;                   //bool flag to ensure that data was successfully pulled from n_response net
        bool do_load;                  //bool flag to see if we can load data or not
        bool do_store;                  

        // instruction to  number of bytes translation function
        int size_bytes(int spec) {
            if(spec == WORD){
                return 4;
            }
            else if(spec == DOUBLEWORD){
                return 8;
            }
            else{
                return 16;
            }
        }

        // Since it is assumed that the processor is Big-
        void encode_be(uint8_t* buf, uint64_t value, int n) {
            // byte 0 = most-significant (stored/printed at lowest address) i.e buf[0]
            for (int i = 0; i < n; i++) {
                int fromLSB = n - 1 - i;
                buf[i] = (fromLSB < 8) ? (uint8_t)((value >> (8 * fromLSB)) & 0xFF) : 0;
            }
        }
        void print_bytes(const uint8_t* buf, int n) {
            log << "0x";
            for (int i = 0; i < n; i++)
                log << std::hex << std::setw(2) << std::setfill('0') << (int)buf[i];
            log << std::dec;
        }
    $

    init $
        pc = 0;
        instr_count = 0;
        srand(1);   // fixed seed for reproducibility
    $

    behavior
        do
            // ================= Step 1: Instruction fetch =================
            $
            req_type = IFETCH;
            req_size = WORD;
            req_addr = (uint32_t)(pc * size_bytes(WORD));                   // word-aligned, in-bounds

            for (int i = 0; i < 16; i++) req_data[i] = 0;                   // cleaning up to reuse the data array

            sitar::pack(req_tok, req_addr, req_type, req_size, req_data);  // 22 byte request token

            ok = false;                                                    //This resets the success flag.

            $;
            do

                wait until (this_phase == 1);                               // transmitting when the we are in writing phase i.e phase 1
                $ok = req_port.push(req_tok);$;                             //trasmittig request token over the net n_request
                if (not ok) then wait end if;                               // if processor was unable to push the token into net then it goes to sleep till the end of the current cycle

            while (not ok) end do;                                          // if token successfully entered the net then the loop breaks else it goes and tries again in next cycle

            $log << endl << "IFETCH  pc=" << pc << "  addr=" << req_addr;$;

            wait until (this_phase == 0 and $resp_port.peek(resp_tok)$);           // processor is put to sleep until it is reading phase (i.e 0) and there is token in n_response net
            $
            pulled = resp_port.pull(resp_tok);                                    // pulling the response from the net into the module
            
            sitar::unpack(resp_tok, resp_error, resp_data);                       // opening the response token and the first 1 byte goes to resp_error, and remaining 16 bytes in resp_data array

            if (resp_error) {
                log << endl << "  IFETCH ERROR: address out of bounds";
            } else {
                log << endl << "  IFETCH OK  data=";
                print_bytes(resp_data, size_bytes(WORD));
            }

            $;

            // ================= Step 2: execution delay =================
            wait(EXECUTION_DELAY, 0);                    // simulating that process is busy executing the instruction it just fetched

            // ================= Step 3: probabilistic LOAD (reading data from memory)=================

            $do_load = (rand() % 100) < P_LOAD;$;   

            if (do_load) then                                     //  if true processor prepares its request token to send it to the memory
                $
                req_type = LOAD;                                  // tells the memory that want to read data
                req_size = WORD;                                  // tells the memory how may bytes of data   

                req_addr = (uint32_t)(200 + (pc * 8) % 800);      // picking a random memory address between 200 to 999 to read from 

                req_addr = req_addr & ~0x3u;                      // WORD alignment (forcing last 2 bits of address to be 00 (for WORD))

                for (int i = 0; i < 16; i++) req_data[i] = 0;    // cleaning out the data array to avoid sending any data

                sitar::pack(req_tok, req_addr, req_type, req_size, req_data);   // packing everything up in a token

                ok = false;                 
                $;
                do
                    wait until (this_phase == 1);              //wait till it is writing phase to write in net n_request

                    $ok = req_port.push(req_tok);$;

                    if (not ok) then wait end if;

                while (not ok) end do;

                $log << endl << "LOAD    pc=" << pc << "  addr=" << req_addr;$;

                wait until (this_phase == 0 and $resp_port.peek(resp_tok)$);
                $
                pulled = resp_port.pull(resp_tok);

                sitar::unpack(resp_tok, resp_error, resp_data);

                if (resp_error) {
                    log << endl << "  LOAD ERROR: address out of bounds";
                } else {
                    log << endl << "  LOAD OK  data=";
                    print_bytes(resp_data, size_bytes(WORD));
                }
                $;
            end if;

            // ================= Step 4: probabilistic STORE =================
            $do_store = (rand() % 100) < P_STORE;$;
            if (do_store) then
                $
                req_type = STORE;
                req_size = WORD;
                req_addr = (uint32_t)(200 + (pc * 8) % 800);

                req_addr = req_addr & ~0x3u;               // WORD alignment
                
                encode_be(req_data, (uint64_t)(pc * 111 + 7), size_bytes(WORD));  // creating a random value to store in the memory

                sitar::pack(req_tok, req_addr, req_type, req_size, req_data);

                ok = false;
                $;
                do
                    wait until (this_phase == 1);
                    $ok = req_port.push(req_tok);$;
                    if (not ok) then wait end if;

                while (not ok) end do;
                $
                log << endl << "STORE   pc=" << pc << "  addr=" << req_addr << "  data=";
                print_bytes(req_data, size_bytes(WORD));
                $;

                // waiting for acknowledgment
                wait until (this_phase == 0 and $resp_port.peek(resp_tok)$);
                $
                pulled = resp_port.pull(resp_tok);
                sitar::unpack(resp_tok, resp_error, resp_data);
                if (resp_error)
                    log << endl << "  STORE ERROR: address out of bounds";
                else
                    log << endl << "  STORE OK";
                $;
            end if;

            $
            pc++;
            instr_count++;
            log << endl << "--- instruction " << instr_count << " complete ---";
            $;
            
        while (instr_count < NUM_INSTR and current_time <= time(MAX_TIME,0)) end do;           // question 3

        $log << endl << "Processor done: " << instr_count << " instructions executed";$;
        stop simulation;
    end behavior
end module



// Memory -----------------------------------------------------------------------

module Cache
    parameter int SIZE = 1024      // structural parameter: memory size in bytes
    parameter int P_HIT = 80       // 80% chance of finding data
    parameter int DELAY_HIT = 2    
    parameter int DELAY_MISS = 20

    inport  req_port  : width 22
    outport resp_port : width 17

    include $#include <cstring>$
    include $#include <cstdint>$
    include $#include <iomanip>$

    decl $
        int DELAY = 3;   // Dummy variable so Top doesn't crash!

        enum AccessType { IFETCH = 0, LOAD = 1, STORE = 2, ATOMICLOADSTORE = 3 };
        enum SizeSpec   { WORD = 0, DOUBLEWORD = 1, QUADWORD = 2 };

        unsigned char mem_array[SIZE];                             // physical storage for the simulation     

        uint32_t req_addr;
        uint8_t  req_type;
        uint8_t  req_size;
        uint8_t  req_data[16];

        uint8_t  resp_error;
        uint8_t  resp_data[16];

        token<22> req_tok;
        token<17> resp_tok;

        bool pulled;
        bool ok;
        bool is_hit;                         //bool flag to see whether it is a hit or miss

        int size_bytes(int spec) {
            if(spec == WORD){
                return 4;
            }
            else if(spec == DOUBLEWORD){
                return 8;
            }
            else{
                return 16;
            }
        }

        void print_bytes(const uint8_t* buf, int n) {
            log << "0x";
            for (int i = 0; i < n; i++)
                log << std::hex << std::setw(2) << std::setfill('0') << (int)buf[i];
            log << std::dec;
        }
    $

    init $
        // Simple known pattern so LOAD/IFETCH results are checkable by hand
        for (int i = 0; i < SIZE; i++)
            mem_array[i] = (unsigned char)(i % 256);                     //usigned char (single byte) can only hold number from 0 to 255
    $

    behavior
        // ================ (Q1) =================
        $
        log.turnOFF();
        log << endl << "MEM: this line is suppressed -- logger is OFF";
        log.turnON();
        log << endl << "MEM: logging re-enabled -- activity log begins below";
        $;

        do
            // ---------- Wait for and pull a request (phase 0) ----------
            $pulled = false;$;
            do
                wait until (this_phase == 0);
                $pulled = req_port.pull(req_tok);$;
                if (not pulled) then wait end if;
            while (not pulled) end do;

            $sitar::unpack(req_tok, req_addr, req_type, req_size, req_data);$;

            // ---------- Simulate access latency ----------
            $
            is_hit = (rand() % 100) < P_HIT;           // finding out if it is a hit or a miss
            $;
            
            if(is_hit) then
                $log << endl << " [CACHE HIT]";$;
                wait(DELAY_HIT,0);
            
            else
                $log << endl << "  [CACHE MISS] Fetching from lower memory...";$;
                wait(DELAY_MISS, 0);
            end if;

            // ---------- Perform the access ----------
            $
            int n = size_bytes(req_size);                                                 // translate WORD -> actual bytes i.e 4
            bool in_bounds = ((uint64_t)req_addr + (uint64_t)n) <= (uint64_t)SIZE;        // the bounds check (safety first)

            resp_error = 0;                                                               // default response template (assuming everything went right)
            for (int i = 0; i < 16; i++) resp_data[i] = 0;                                // cleaning out to make sure it doesnt send the old data back

            if (!in_bounds) {                                                             // when out-of-bounds throw and error
                resp_error = 1;
                log << endl << "MEM ERROR: out-of-bounds  addr=" << req_addr
                    << "  type=" << (int)req_type;
            } 
            else {
                if (req_type == STORE || req_type == ATOMICLOADSTORE) {

                    memcpy(&mem_array[req_addr], req_data, n);                           //copying n bytes from the req_data array into mem_array starting at req_addr
                    log << endl << "MEM WRITE  addr=" << req_addr << "  data=";
                    print_bytes(req_data, n);
                }
                if (req_type == IFETCH || req_type == LOAD || req_type == ATOMICLOADSTORE) {
                    memcpy(resp_data, &mem_array[req_addr], n);                         //copying n bytes from the mem_array  into req_data starting at req_addr in mem_array
                    log << endl << "MEM READ   addr=" << req_addr << "  data=";
                    print_bytes(resp_data, n);
                }
            }

            sitar::pack(resp_tok, resp_error, resp_data);                              // packing the resp_data into and error_status into a token
            ok = false;
            $;

            // ---------- Send response (phase 1) ----------
            do
                wait until (this_phase == 1);
                $ok = resp_port.push(resp_tok);$;
                if (not ok) then wait end if;
            while (not ok) end do;
        while (1) end do;
    end behavior
end module



// Memory-----------------------------------------------------------------------------------


module Memory
    parameter int SIZE = 1024      // structural parameter: memory size in bytes

    inport  req_port  : width 22
    outport resp_port : width 17

    include $#include <cstring>$
    include $#include <cstdint>$
    include $#include <iomanip>$

    decl $
        int DELAY = 3;   // default; overridden from Top's init

        enum AccessType { IFETCH = 0, LOAD = 1, STORE = 2, ATOMICLOADSTORE = 3 };
        enum SizeSpec   { WORD = 0, DOUBLEWORD = 1, QUADWORD = 2 };

        unsigned char mem_array[SIZE];                             // physical storage for the simulation     

        uint32_t req_addr;
        uint8_t  req_type;
        uint8_t  req_size;
        uint8_t  req_data[16];

        uint8_t  resp_error;
        uint8_t  resp_data[16];

        token<22> req_tok;
        token<17> resp_tok;

        bool pulled;
        bool ok;

        int size_bytes(int spec) {
            if(spec == WORD){
                return 4;
            }
            else if(spec == DOUBLEWORD){
                return 8;
            }
            else{
                return 16;
            }
        }

        void print_bytes(const uint8_t* buf, int n) {
            log << "0x";
            for (int i = 0; i < n; i++)
                log << std::hex << std::setw(2) << std::setfill('0') << (int)buf[i];
            log << std::dec;
        }
    $

    init $
        // Simple known pattern so LOAD/IFETCH results are checkable by hand
        for (int i = 0; i < SIZE; i++)
            mem_array[i] = (unsigned char)(i % 256);                     //usigned char (single byte) can only hold number from 0 to 255
    $

    behavior
        // ================ (Q1) =================
        $
        log.turnOFF();
        log << endl << "MEM: this line is suppressed -- logger is OFF";
        log.turnON();
        log << endl << "MEM: logging re-enabled -- activity log begins below";
        $;

        do
            // ---------- Wait for and pull a request (phase 0) ----------
            $pulled = false;$;
            do
                wait until (this_phase == 0);
                $pulled = req_port.pull(req_tok);$;
                if (not pulled) then wait end if;
            while (not pulled) end do;

            $sitar::unpack(req_tok, req_addr, req_type, req_size, req_data);$;

            // ---------- Simulate access latency ----------
            wait(DELAY, 0);

            // ---------- Perform the access ----------
            $
            int n = size_bytes(req_size);                                                 // translate WORD -> actual bytes i.e 4
            bool in_bounds = ((uint64_t)req_addr + (uint64_t)n) <= (uint64_t)SIZE;        // the bounds check (safety first)

            resp_error = 0;                                                               // default response template (assuming everything went right)
            for (int i = 0; i < 16; i++) resp_data[i] = 0;                                // cleaning out to make sure it doesnt send the old data back

            if (!in_bounds) {                                                             // when out-of-bounds throw and error
                resp_error = 1;
                log << endl << "MEM ERROR: out-of-bounds  addr=" << req_addr
                    << "  type=" << (int)req_type;
            } 
            else {
                if (req_type == STORE || req_type == ATOMICLOADSTORE) {

                    memcpy(&mem_array[req_addr], req_data, n);                           //copying n bytes from the req_data array into mem_array starting at req_addr
                    log << endl << "MEM WRITE  addr=" << req_addr << "  data=";
                    print_bytes(req_data, n);
                }
                if (req_type == IFETCH || req_type == LOAD || req_type == ATOMICLOADSTORE) {
                    memcpy(resp_data, &mem_array[req_addr], n);                         //copying n bytes from the mem_array  into req_data starting at req_addr in mem_array
                    log << endl << "MEM READ   addr=" << req_addr << "  data=";
                    print_bytes(resp_data, n);
                }
            }

            sitar::pack(resp_tok, resp_error, resp_data);                              // packing the resp_data into and error_status into a token
            ok = false;
            $;

            // ---------- Send response (phase 1) ----------
            do
                wait until (this_phase == 1);
                $ok = resp_port.push(resp_tok);$;
                if (not ok) then wait end if;
            while (not ok) end do;
        while (1) end do;
    end behavior
end module