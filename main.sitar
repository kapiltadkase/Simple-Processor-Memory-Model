// Two cores with private caches and a shared data memory.
// Sitar controls timing and parallel work; code between $ markers is C++.
// "wait" pauses a worker, and || separates workers that run alongside each other.

// Top connects all the parts of the simulation.
module Top
    submodule core : Core
    submodule instruction_memory : Memory
    submodule data_memory : Memory
    // Each connection holds one message: a 10-byte request or a 5-byte reply.
    net instruction_request : capacity 1 width 10
    net instruction_response : capacity 1 width 5
    net data_request : capacity 1 width 10
    net data_response : capacity 1 width 5

    // Instruction requests stay private; data requests pass through the arbiter.
    core.instruction_request => instruction_request
    instruction_memory.request <= instruction_request
    instruction_memory.response => instruction_response
    core.instruction_response <= instruction_response
    core.data_request => data_request
    arbiter.request0 <= data_request
    arbiter.response0 => data_response
    core.data_response <= data_response
    submodule core1 : Core
    submodule instruction_memory1 : Memory
    submodule arbiter : Arbiter
    net shared_request : capacity 1 width 10
    net shared_response : capacity 1 width 5
    arbiter.memory_request => shared_request
    data_memory.request <= shared_request
    data_memory.response => shared_response
    arbiter.memory_response <= shared_response
    // Each connection holds one message: a 10-byte request or a 5-byte reply.
    net instruction_request1 : capacity 1 width 10
    net instruction_response1 : capacity 1 width 5
    net data_request1 : capacity 1 width 10
    net data_response1 : capacity 1 width 5

    // Instruction requests stay private; data requests pass through the arbiter.
    core1.instruction_request => instruction_request1
    instruction_memory1.request <= instruction_request1
    instruction_memory1.response => instruction_response1
    core1.instruction_response <= instruction_response1
    core1.data_request => data_request1
    arbiter.request1 <= data_request1
    arbiter.response1 => data_response1
    core1.data_response <= data_response1
    decl $
        // When both cores ask together, this core goes first.
        int next_snoop = 0;
        uint32_t expected[64];
        void verify_data() {
            auto& a = core.data_cache;
            auto& b = core1.data_cache;
            using State = Cache<>::MesiState;
            for (unsigned word = 0; word < 64; ++word) {
                unsigned addr = word * 4;
                int aw = a.find_way(addr), bw = b.find_way(addr);
                bool modified = false;
                for (auto* cache : {&a, &b}) {
                    int way = cache == &a ? aw : bw;
                    if (way < 0) continue;
                    int set = addr / cache->block_bytes % cache->set_count;
                    auto state = cache->mesi_state(set, way);
                    assert(aw < 0 || bw < 0 || state == State::S);
                    assert(cache->line_word(set, way, addr % cache->block_bytes) == expected[word]);
                    modified |= state == State::M;
                }
                // Memory may have serviced a write whose acknowledgement is still in flight.
                bool awaiting_ack = false;
                for (auto* c : {&a, &b})
                    if (c->through_pending && c->saved_address == addr)
                        awaiting_ack |= data_memory.words[word] == c->saved_data;
                assert(modified || data_memory.words[word] == expected[word] || awaiting_ack);
            }
        }
    $
    init $
        // Sitar's driver owns Top for the lifetime of the process. It can end
        // the run at the cycle limit before either processor reaches done.
        static Top* model = this;
        std::atexit([] {
            const char* names[] = {"hits","misses","BusRd","BusRdX","BusUpgr","invalidations","writebacks","coherence_misses","memory_write_bytes"};
            uint64_t totals[9] = {};
            for (auto* c : {&model->core.data_cache, &model->core1.data_cache}) {
                uint64_t row[] = {c->hits,c->misses,c->grants[0],c->grants[1],c->grants[2],
                                  c->invalidations,c->writebacks,c->coherence_misses,
                                  model->data_memory.write_bytes[c->core_id] + c->intervention_bytes};
                std::cout << "DATA CACHE core=" << int(c->core_id);
                for (int i = 0; i < 9; ++i) {
                    std::cout << " " << names[i] << "=" << row[i];
                    totals[i] += row[i];
                }
                std::cout << '\n';
            }
            std::cout << "DATA CACHE total";
            for (int i = 0; i < 9; ++i) std::cout << " " << names[i] << "=" << totals[i];
            std::cout << '\n';
        });
        for (unsigned i = 0; i < 64; ++i) expected[i] = i;
        for (auto* cache : {&core.data_cache, &core1.data_cache}) {
            cache->expected_words = expected;
            cache->verify = [this] { verify_data(); };
        }
        core.instruction_cache.core_id = 0;
        core.data_cache.core_id = 0;
        core1.instruction_cache.core_id = 1;
        core1.data_cache.core_id = 1;
        instruction_memory1.core_id = 1;
        core.processor.peer_done = &core1.processor.done;
        core1.processor.peer_done = &core.processor.done;
        core1.instruction_cache.CACHE_DELAY = 1;
        core1.data_cache.CACHE_DELAY = 1;
        instruction_memory1.MEM_DELAY = 1;

        if (const char* setting = std::getenv("SITAR_WRITE_POLICY")) {
            std::string name(setting);
            if (name != "write-back" && name != "write-through")
                throw std::runtime_error("SITAR_WRITE_POLICY must be write-back or write-through");
            core.data_cache.write_through = core1.data_cache.write_through = name == "write-through";
        }
        if (const char* setting = std::getenv("SITAR_POLICY")) {
            std::string name(setting);
            Cache<>::ReplacementPolicy policy;
            if (name == "lru") policy = Cache<>::LRU;
            else if (name == "fifo") policy = Cache<>::FIFO;
            else if (name == "random") policy = Cache<>::RANDOM;
            else throw std::runtime_error("SITAR_POLICY must be lru, fifo or random");
            core.data_cache.replacement_policy = core1.data_cache.replacement_policy = policy;
        }
        core.instruction_cache.CACHE_DELAY = 0;
        core.data_cache.CACHE_DELAY = 0;
        instruction_memory.MEM_DELAY = 0;
        data_memory.MEM_DELAY = 0;
    $
    behavior
        [
            wait until ($core.processor.done && core1.processor.done$);
            $log << endl << "PASS two_cores=2";$;
            stop simulation;
        ||
            do
                // Finish any cache fill or eviction before examining the block.
                wait until (this_phase == 0 and
                    $(!core.data_cache.busy || core.data_cache.bus_pending) &&
                     (!core1.data_cache.busy || core1.data_cache.bus_pending) &&
                     (core.data_cache.bus_pending || core1.data_cache.bus_pending)$);
                $
                    Cache<>* caches[] = {&core.data_cache, &core1.data_cache};
                    int owner = caches[next_snoop]->bus_pending ? next_snoop : 1 - next_snoop;
                    auto& requester = *caches[owner];
                    auto& peer = *caches[1 - owner];

                    // While this upgrade waited, the other core may have invalidated its copy.
                    requester.bus_retry = requester.bus_request.op == Cache<>::BusUpgr &&
                                          !requester.is_shared(requester.bus_request.block);
                    if (!requester.bus_retry) {
                        requester.grants[requester.bus_request.op]++;
                        requester.peer_state = peer.snoop(requester.bus_request, data_memory.words);
                    }

                    // The requester can now read its result. The peer gets priority next time.
                    requester.bus_pending = false;
                    next_snoop = 1 - owner;
                $;
                wait until (this_phase == 1);
            while (1) end do;
        ];
    end behavior
end module

// Core contains the processor and its two caches.
module Core
    outport instruction_request : width 10
    inport instruction_response : width 5
    outport data_request : width 10
    inport data_response : width 5
    procedure processor : Processor
    procedure instruction_cache : Cache<>
    procedure data_cache : Cache<>
    init $
        // Tell each cache where to send requests and where to receive replies.
        instruction_cache.memory_request = &instruction_request;
        instruction_cache.memory_response = &instruction_response;
        data_cache.coherent = true;
        data_cache.memory_request = &data_request;
        data_cache.memory_response = &data_response;
        processor.instruction_cache = &instruction_cache;
        processor.data_cache = &data_cache;
    $
    behavior
        // All three keep running together; one waiting cache does not stop the other.
        [
            run processor;
        ||
            run instruction_cache;
        ||
            run data_cache;
        ];
    end behavior
end module

// A cache keeps small blocks of memory nearby to avoid repeated memory trips.
procedure Cache
    // Sets are groups; ways are the block slots in each group. Block size is in bytes.
    parameter int NUM_SETS = 2
    parameter int NUM_WAYS = 2
    parameter int BLOCK_SIZE = 16
    include $
        #include <cassert>
        #include <stdexcept>
        #include <functional>
        #include <random>
    $
    decl $
        // When a set is full, LRU removes its least recently used block.
        // FIFO removes the block loaded first, even if it was used recently.
        // RANDOM picks a slot at random instead. Empty slots are always used first.
        enum ReplacementPolicy { LRU, RANDOM, FIFO };
        ReplacementPolicy replacement_policy = LRU;
        uint8_t core_id = 0; // Identifies all requests on this private cache interface.
        int CACHE_DELAY = 0;

        // Set this to true to make extra reads wait while the cache is busy.
        bool BLOCKING = false;
        // There is room for one ordinary request and one extra read.
        // The caller must wait for both to finish before sending another ordinary request.
        // busy means an ordinary request is active; writing means a write-back is active.
        bool busy = false, writing = false;
        uint64_t read_request = 0, read_response = 0, read_start = 0, read_finish = 0;
        uint32_t read_address = 0, read_value = 0;
        uint8_t read_error = 0;
        int read_slot, read_way, read_offset;
        uint64_t overlap_hits = 0;

        // Find the extra read in the cache. -1 means it is missing or its address is invalid.
        int find_read() {
            if (read_address > 252 || read_address % 4) return -1;
            return find_way(read_address);
        }

        int find_way(uint32_t addr) const {
            int set = (addr / BLOCK_SIZE) % NUM_SETS;
            for (int i = 0; i < NUM_WAYS; i++)
                if (mesi[set][i] != MesiState::I && tags[set][i] == addr / BLOCK_SIZE / NUM_SETS)
                    return i;
            return -1;
        }

        // During write-back, an extra read may use another block already in the cache.
        // It cannot read the block being evicted or start another memory transfer.
        bool can_read() {
            if (!busy) return true;
            if (BLOCKING || !writing) return false;
            int found = find_read();
            return found >= 0 && !((read_address / BLOCK_SIZE) % NUM_SETS == uint32_t(slot) && found == way);
        }

        // Connections to memory, followed by the ordinary request and its result.
        outport<10>* memory_request = nullptr;
        inport<5>* memory_response = nullptr;
        // A larger request number means new work; matching numbers mean it is done.
        uint64_t request_id = 0, response_id = 0;
        uint32_t address = 0, write_data = 0, read_data = 0;
        uint8_t write = 0, error = 0;
        uint64_t start_time = 0, finish_time = 0, hits = 0, misses = 0, writebacks = 0;

        // Reject cache dimensions that the address calculations cannot support.
        static_assert(NUM_SETS > 0 && !(NUM_SETS & (NUM_SETS - 1)), "Invalid set count");
        static_assert(NUM_WAYS > 0 && !(NUM_WAYS & (NUM_WAYS - 1)), "Invalid way count");
        static_assert(BLOCK_SIZE >= 4 && BLOCK_SIZE <= 256 && !(BLOCK_SIZE & (BLOCK_SIZE - 1)), "Invalid block size");

        enum class MesiState : uint8_t {
            I = 0,  // Invalid: this slot has no usable copy. All slots start here.
            M,      // Modified: this cache has a newer value than memory.
            E,      // Exclusive: only this cache holds a clean copy.
            S       // Shared: another cache may also hold a copy.
        };
        MesiState mesi[NUM_SETS][NUM_WAYS] = {};

        MesiState mesi_state(int set, int way_index) const {
            assert(set >= 0 && set < NUM_SETS && way_index >= 0 && way_index < NUM_WAYS);
            return mesi[set][way_index];
        }

        enum BusOp {
            BusRd,   // Ask for a copy to read.
            BusRdX,  // Ask for a copy to write. The peer must give up its copy.
            BusUpgr  // We already have a shared copy. Ask the peer to give up its copy.
        };

        struct BusRequest {
            uint8_t requester;
            BusOp op;
            uint32_t block;  // Byte address of the first byte in the block.
        };

        BusRequest bus_request{};
        uint64_t bus_requests = 0;
        uint64_t grants[3] = {}, invalidations = 0, coherence_misses = 0;
        static constexpr int block_bytes = BLOCK_SIZE, set_count = NUM_SETS;
        bool invalidated[256 / BLOCK_SIZE] = {};
        uint32_t* expected_words = nullptr;
        std::function<void()> verify;
        bool write_through = false, through_pending = false;
        uint64_t intervention_bytes = 0;
        bool coherent = false;  // Only private data caches share this bus.
        bool bus_pending = false;
        bool bus_retry = false;  // A queued upgrade lost its shared copy.
        MesiState peer_state = MesiState::I;  // Peer state before the last successful snoop.

        bool is_shared(uint32_t block) const {
            int found = find_way(block);
            return found >= 0 && mesi[block / BLOCK_SIZE % NUM_SETS][found] == MesiState::S;
        }

        void request_bus(BusOp op, uint32_t block) {
            if (bus_pending || block >= 256 || block % BLOCK_SIZE)
                throw std::logic_error("Pending bus request or invalid block address");
            if (op == BusUpgr && !is_shared(block))
                throw std::logic_error("BusUpgr requires a shared line");
            bus_requests++;
            bus_request = {core_id, op, block};
            bus_pending = true;
        }

        MesiState snoop(const BusRequest& req, uint32_t* memory_words) {
            assert(req.requester != core_id);
            int found = find_way(req.block);
            if (found < 0) return MesiState::I;

            int set = req.block / BLOCK_SIZE % NUM_SETS;
            MesiState prior = mesi[set][found];

            // Save every word before giving up the only up-to-date copy.
            if (prior == MesiState::M) {
                for (int pos = 0; pos < BLOCK_SIZE; pos += 4)
                    memory_words[(req.block + pos) / 4] = line_word(set, found, pos);
                writebacks++;
                intervention_bytes += BLOCK_SIZE;
            }

            // Two readers can share a block. A writer needs the peer to drop it.
            mesi[set][found] = req.op == BusRd ? MesiState::S : MesiState::I;
            if (req.op != BusRd) {
                invalidations++;
                invalidated[req.block / BLOCK_SIZE] = true;
            }
            return prior;
        }

        uint32_t tags[NUM_SETS][NUM_WAYS] = {};
        uint8_t values[NUM_SETS][NUM_WAYS][BLOCK_SIZE] = {};

        // A fixed seed makes random replacement repeatable between simulation runs.
        std::mt19937 generator{1};

        // Replacement ranks: 0 means newest; larger numbers mean older, within each set.
        // LRU updates them on every access; FIFO updates them only when loading a block.
        int recency[NUM_SETS][NUM_WAYS] = {};
        // LRU / FIFO shared helper: mark this block newest and age the blocks that were newer.
        void touch(int set, int accessed) {
            for (int i = 0; i < NUM_WAYS; i++)
                if (mesi[set][i] != MesiState::I && i != accessed && recency[set][i] <= recency[set][accessed])
                    recency[set][i]++;
            recency[set][accessed] = 0;
        }

        // Keep the active request safe while waiting for memory.
        // slot is the set, way is the chosen block slot, and offset is the byte within it.
        uint32_t saved_address, saved_data, tag, base, victim_base;
        uint8_t saved_write;
        uint64_t active_id;
        int slot, way, offset, position;

        // Split one 32-bit word into four bytes, most significant byte first.
        void save_word(int pos, uint32_t value) {
            for (int i = 0; i < 4; i++) values[slot][way][pos+i] = value >> (24-8*i);
        }

        // Join those four bytes back into a word.
        uint32_t line_word(int set, int line, int pos) const {
            uint32_t value = 0;
            for (int i = 0; i < 4; i++) value = (value << 8) | values[set][line][pos+i];
            return value;
        }
        bool hit, sent;
        token<10> request_token;
        token<5> response_token;
    $
    behavior
        $if ((replacement_policy != LRU && replacement_policy != RANDOM && replacement_policy != FIFO) || CACHE_DELAY < 0 || !memory_request || !memory_response)
            throw std::runtime_error("Invalid cache configuration");$;
        [
            do
                // 1. Wait for an ordinary request and remember its inputs.
                wait until (request_id > response_id);
                $
                assert(request_id == response_id + 1);
                busy = true;
                active_id = request_id;
                saved_address = address;
                saved_data = write_data;
                saved_write = write;
                start_time = current_time.toUint64();
                // Error codes: 0 = OK, 1 = outside memory, 2 = unaligned, 3 = invalid operation.
                // Each word is four bytes, so valid addresses are 0, 4, ..., 252.
                error = saved_write > 1 ? 3 : saved_address % 4 ? 2 : saved_address > 252 ? 1 : 0;

                // 2. Work out which block, set, and byte the address refers to.
                base = saved_address / BLOCK_SIZE * BLOCK_SIZE;
                offset = saved_address % BLOCK_SIZE;
                slot = (saved_address / BLOCK_SIZE) % NUM_SETS;
                tag = saved_address / BLOCK_SIZE / NUM_SETS;

                // While queued, either cache can be snooped. After grant, busy keeps
                // later grants waiting until this access has installed its result.
                way = find_way(saved_address);
                $;
                if ($coherent && !error && (way < 0 || (saved_write && is_shared(base)))$) then
                    $request_bus(!saved_write ? BusRd : way < 0 ? BusRdX : BusUpgr, base);$;
                    wait until (not bus_pending);
                    if (bus_retry) then
                        // The other writer invalidated our shared copy while we waited.
                        $request_bus(BusRdX, base);$;
                        wait until (not bus_pending);
                    end if;
                end if;
                $
                // A hit means the requested block is already in this set.
                way = find_way(saved_address);
                hit = !error && way >= 0;

                // 3. On a miss, use an empty slot or choose a block to replace.
                if (!error && !hit) {
                    for (int i = 0; i < NUM_WAYS; i++)
                        if (mesi[slot][i] == MesiState::I) {
                            way = i;
                            break;
                        }
                    if (way < 0) {
                        // RANDOM replacement: evict a uniformly random way when the set is full.
                        if (replacement_policy == RANDOM)
                            way = std::uniform_int_distribution<int>(0, NUM_WAYS - 1)(generator);
                        else {
                            // LRU / FIFO replacement: evict the largest rank (oldest use / oldest insertion).
                            way = 0;
                            for (int i = 1; i < NUM_WAYS; i++)
                                if (recency[slot][i] > recency[slot][way]) way = i;
                        }
                    }
                    // Remember where the old block belongs in memory before replacing it.
                    victim_base = (tags[slot][way] * NUM_SETS + slot) * BLOCK_SIZE;
                }
                read_data = 0;
                $;
                wait(CACHE_DELAY, 0);
                if (not error) then
                    // 4. Save a changed old block before throwing it away.
                    // Transfer four bytes at a time and wait for each reply.
                    if (not hit and $mesi[slot][way] == MesiState::M$) then
                        $writing=true;
                        position = 0;
                        log << endl << "WRITEBACK_START base=" << victim_base;$;
                        do
                            $sitar::pack(request_token, core_id, uint8_t(1), uint32_t(victim_base+position), line_word(slot, way, position));
                            sent = false;$;
                            do
                                // Retry if the connection is full; send during phase 1.
                                wait until (this_phase == 1);
                                $sent = memory_request->push(request_token);$;
                                if (not sent) then
                                    wait;
                                end if;
                            while (not sent) end do;
                            wait until (this_phase == 0 and $memory_response->peek(response_token)$);
                            $memory_response->pull(response_token);
                            sitar::unpack(response_token, error, read_data);
                            position+=4;$;
                        while (not error and position < BLOCK_SIZE) end do;
                        $writing=false;
                        if (!error) {
                            writebacks++;
                            log << endl << "WRITEBACK base=" << victim_base << " bytes=" << BLOCK_SIZE;
                        }$;
                    end if;

                    // 5. Fetch the missing block. It becomes usable only after every word arrives.
                    if (not error and not hit) then
                        $mesi[slot][way] = MesiState::I;
                        position = 0;$;
                        do
                            $sitar::pack(request_token, core_id, uint8_t(0), uint32_t(base+position), uint32_t(0));
                            sent = false;$;
                            do
                                // Retry if the connection is full; send during phase 1.
                                wait until (this_phase == 1);
                                $sent = memory_request->push(request_token);$;
                                if (not sent) then
                                    wait;
                                end if;
                            while (not sent) end do;
                            wait until (this_phase == 0 and $memory_response->peek(response_token)$);
                            $memory_response->pull(response_token);
                            sitar::unpack(response_token, error, read_data);
                            if (!error) save_word(position, read_data);
                            position+=4;$;
                        while (not error and position < BLOCK_SIZE) end do;
                        $if (!error) {
                            mesi[slot][way] = coherent && peer_state == MesiState::I ? MesiState::E : MesiState::S;
                            tags[slot][way] = tag;
                        }$;
                    end if;

                    // Hold exclusive ownership until memory acknowledges the write-through store.
                    if (not error and saved_write and write_through) then
                        $through_pending = true;
                        sitar::pack(request_token, core_id, uint8_t(1), saved_address, saved_data);
                        sent = false;$;
                        do
                            wait until (this_phase == 1);
                            $sent = memory_request->push(request_token);$;
                            if (not sent) then wait; end if;
                        while (not sent) end do;
                        wait until (this_phase == 0 and $memory_response->peek(response_token)$);
                        $memory_response->pull(response_token);
                        sitar::unpack(response_token, error, read_data);
                        through_pending = false;$;
                    end if;
                    $if (!error && saved_write) {
                        save_word(offset, saved_data);
                        mesi[slot][way] = write_through ? MesiState::E : MesiState::M;
                    }
                    // LRU policy: update ranks on every successful access, including hits.
                    // FIFO policy: update ranks only on insertion (a miss); hits keep their place.
                    if (!error && (replacement_policy == LRU || (replacement_policy == FIFO && !hit))) {
                        if (!hit) recency[slot][way] = NUM_WAYS;
                        touch(slot, way);
                    }
                    read_data = error ? 0 : line_word(slot, way, offset);$;
                end if;
                $
                // 7. Publish the result so the processor knows this request is finished.
                if (!error) {
                    if (hit) hits++;
                    else {
                        misses++;
                        if (invalidated[base / BLOCK_SIZE]) coherence_misses++;
                        invalidated[base / BLOCK_SIZE] = false;
                    }
                    if (expected_words) {
                        if (saved_write) expected_words[saved_address / 4] = saved_data;
                        assert(read_data == expected_words[saved_address / 4]);
                    }
                }
                finish_time = current_time.toUint64();
                busy = false;
                response_id = active_id;
                if (verify) verify();
                log << endl << "ACCESS core=" << int(core_id) << " id=" << response_id << " address=" << saved_address
                    << " hit=" << hit << " write=" << int(saved_write)
                    << " error=" << int(error) << " ticks=" << finish_time-start_time;
                $;
            while (1) end do;
        ||
            // Extra read worker: a cached read can proceed during write-back.
            // During a fill, or when the read needs memory, it must wait.
            do
                wait until (read_request > read_response and $can_read()$);
                $assert(read_request == read_response+1);
                read_start = current_time.toUint64();
                read_way = find_read();
                read_slot = (read_address/BLOCK_SIZE)%NUM_SETS;
                read_offset = read_address%BLOCK_SIZE;
                read_error = read_address%4 ? 2 : read_address>252 ? 1 : 0;
                read_value = 0;
                if (!read_error && read_way >= 0) {
                    for (int i = 0; i < 4; i++) read_value=(read_value<<8)|values[read_slot][read_way][read_offset+i];
                    // LRU policy for extra read hits: refresh recency; FIFO keeps insertion order.
                    if (replacement_policy == LRU) touch(read_slot, read_way);
                    if (writing) overlap_hits++;
                    if (expected_words) assert(read_value == expected_words[read_address/4]);
                }$;
                if (not read_error and read_way < 0) then
                    // This read is missing from the cache: let the ordinary worker fetch it.
                    wait until (not busy and request_id == response_id);
                    $address=read_address;
                    write = 0;
                    request_id++;$;
                    wait until (request_id == response_id);
                    $read_value=read_data;
                    read_error = error;$;
                else
                    wait(CACHE_DELAY, 0);
                end if;
                $if (!read_error && read_way >= 0) hits++;
                read_finish=current_time.toUint64();
                read_response = read_request;
                if (verify) verify();
                log << endl << "READ_COMPLETE core=" << int(core_id) << " address=" << read_address << " value=" << read_value
                    << " writing=" << writing << " finish=" << current_time;$;
            while (1) end do;
        ];
    end behavior
end procedure

// Shared-memory test: evict cached copies before checking another core's store.
procedure Processor
    include $
        #include "Cache.h"
        #include <cstdlib>
        #include <string>
    $
    decl $
        Cache<>* instruction_cache = nullptr;
        Cache<>* data_cache = nullptr;
        bool done = false;
        bool* peer_done = nullptr;
        int index = 0;
        std::mt19937 rng;
        std::string workload = "fixed";
        uint32_t seed = 42;
        uint32_t addresses[8] = {0, 32, 64, 0, 32, 64, 0, 0};
    $
    behavior
        $if (const char* mode = std::getenv("SITAR_WORKLOAD")) workload = mode;
        if (workload != "fixed" && workload != "uniform" && workload != "locality")
            throw std::runtime_error("Choose fixed, uniform or locality for SITAR_WORKLOAD");$;
        if ($workload == "fixed"$) then
            do
                if (index == 3 and $data_cache->core_id == 1$) then
                    wait until ($*peer_done$);
                end if;
                $data_cache->address = addresses[index];
                data_cache->write = index == 3 && data_cache->core_id == 0;
                data_cache->write_data = 12345;
                data_cache->request_id++;$;
                wait until ($data_cache->request_id == data_cache->response_id$);
                $assert(data_cache->error == 0);
                assert(data_cache->read_data == (addresses[index] == 0 && index >= 3 ? 12345 : addresses[index]/4));
                if (index == 7) assert(data_cache->hit);
                index++;$;
            while (index < 8) end do;
            $assert(data_cache->replacement_policy == Cache<>::RANDOM || data_cache->core_id == 1 || data_cache->writebacks == (data_cache->write_through ? 0u : 1u));
            log << endl << "PASS shared core=" << int(data_cache->core_id);$;
        else
            $if (const char* value = std::getenv("SITAR_SEED")) {
                std::string digits(value);
                if (digits.empty() || digits.find_first_not_of("0123456789") != std::string::npos ||
                    std::stoull(digits) > UINT32_MAX)
                    throw std::runtime_error("SITAR_SEED must be an unsigned 32-bit integer");
                seed = std::stoul(digits);
            }
            rng.seed(seed + data_cache->core_id);
            log << endl << "WORKLOAD " << workload << " core=" << int(data_cache->core_id)
                << " seed=" << seed << " requests=256";$;
            do
                // Both modes use the same random draws. Only the address range changes.
                $uint32_t word = rng() % 64;
                bool hot = rng() % 4 != 0;
                if (workload == "locality" && hot) word %= 8;
                data_cache->address = 4 * word;
                data_cache->write = rng() % 4 == 0;
                data_cache->write_data = rng();
                data_cache->request_id++;$;
                wait until ($data_cache->request_id == data_cache->response_id$);
                $assert(data_cache->error == 0);
                index++;$;
            while (index < 256) end do;
            $assert(data_cache->hits + data_cache->misses == 256);$;
        end if;
        $done = true;$;
    end behavior
end procedure

// Memory holds 64 four-byte words (256 bytes total).
// A store reply returns the value just written, so the cache can check completion.
module Memory
    inport request : width 10
    outport response : width 5
    include $
        #include <stdexcept>
        #include <cassert>
    $
    decl $
        uint8_t core_id = 0, request_core;
        int MEM_DELAY = 0;
        uint32_t words[64], address, value;
        uint64_t write_bytes[2] = {};
        uint8_t write, error;
        bool sent;
        token<10> request_token;
        token<5> response_token;
    $
    // Start with predictable data: word 0 contains 0, word 1 contains 1, and so on.
    init $for (int i = 0; i < 64; i++) words[i]=i;$
    behavior
        $if (MEM_DELAY < 0) throw std::runtime_error("Negative memory delay");$;
        do
            // Receive during phase 0, then wait out the configured memory delay.
            wait until (this_phase == 0 and $request.peek(request_token)$);
            $request.pull(request_token);
            sitar::unpack(request_token, request_core, write, address, value);
            assert(request_core < 2);$;
            wait(MEM_DELAY, 0);
            $
            // Validate before indexing memory; invalid requests return an error and zero.
            error = write > 1 ? 3 : address % 4 ? 2 : address > 252 ? 1 : 0;
            if (!error) {
                if (write) { words[address/4]=value; write_bytes[request_core] += 4; }
                value = words[address/4];
            } else value=0;
            // Package the error code and value into a reply.
            sitar::pack(response_token, error, value);
            sent = false;
            $;
            do
                wait until (this_phase == 1);
                $sent=response.push(response_token);$;
                if (not sent) then
                    wait;
                end if;
            while (not sent) end do;
        while (1) end do;
    end behavior
end module

// One outstanding word transaction; remember its owner until its reply is delivered.
module Arbiter
    inport request0 : width 10
    inport request1 : width 10
    outport response0 : width 5
    outport response1 : width 5
    outport memory_request : width 10
    inport memory_response : width 5
    decl $
        token<10> request_token;
        token<5> response_token;
        bool ready0, ready1, sent;
        int owner, next = 0;
    $
    behavior
        do
            wait until (this_phase == 0 and $(request0.peek(request_token) || request1.peek(request_token))$);
            $ready0 = request0.peek(request_token);
            ready1 = request1.peek(request_token);
            owner = ready0 && ready1 ? next : ready0 ? 0 : 1;
            if (owner == 0) request0.pull(request_token);
            else request1.pull(request_token);
            next = 1-owner;
            sent = false;$;
            do
                wait until (this_phase == 1);
                $sent = memory_request.push(request_token);$;
                if (not sent) then
                    wait;
                end if;
            while (not sent) end do;
            wait until (this_phase == 0 and $memory_response.peek(response_token)$);
            $memory_response.pull(response_token); sent = false;$;
            do
                wait until (this_phase == 1);
                $sent = owner == 0 ? response0.push(response_token) : response1.push(response_token);$;
                if (not sent) then
                    wait;
                end if;
            while (not sent) end do;
        while (1) end do;
    end behavior
end module
