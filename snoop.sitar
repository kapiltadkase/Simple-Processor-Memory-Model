decl $
    struct Step {
        int core, write, value, result;
        Cache<>::MesiState state[2];
        int requests[2];
    };
    using State = Cache<>::MesiState;
    int step_index = 0;
    int eviction_index = 0;
    // Core, byte address, write flag, value. All addresses map to set 1.
    const int evictions[9][4] = {
        {0,48,1,701}, {0,52,1,702}, {0,80,0,0}, {1,80,1,703},
        {0,112,0,0}, {0,144,0,0}, {0,176,0,0}, {1,144,0,0}, {0,208,0,0}
    };
    uint64_t initial_writebacks;
    int invalidated_way;
    const Step steps[10] = {
        {0, 0, 0, 11, {State::E, State::I}, {1, 0}},
        {0, 0, 0, 11, {State::E, State::I}, {1, 0}},
        {0, 1, 101, 101, {State::M, State::I}, {1, 0}},
        {0, 0, 0, 101, {State::M, State::I}, {1, 0}},
        {0, 1, 102, 102, {State::M, State::I}, {1, 0}},
        {1, 0, 0, 102, {State::S, State::S}, {1, 1}},
        {0, 0, 0, 102, {State::S, State::S}, {1, 1}},
        {1, 1, 201, 201, {State::I, State::M}, {1, 2}},
        {0, 1, 301, 301, {State::M, State::I}, {2, 2}},
        {1, 0, 0, 301, {State::S, State::S}, {2, 3}},
    };
$
behavior
// Each row drives an ordinary processor access to byte address 44.
// Check both caches and their bus traffic after every response.
do
    $
        const auto& step = steps[step_index];
        auto& cache = step.core ? core1.data_cache : core.data_cache;
        cache.address = 44;
        cache.write = step.write;
        cache.write_data = step.value;
        cache.request_id++;
    $;
    wait until ($core.data_cache.request_id == core.data_cache.response_id &&
                 core1.data_cache.request_id == core1.data_cache.response_id$);
    $
        const auto& step = steps[step_index++];
        Cache<>* caches[] = {&core.data_cache, &core1.data_cache};
        assert(caches[step.core]->read_data == uint32_t(step.result));
        for (int i = 0; i < 2; ++i) {
            int way = caches[i]->find_way(44);
            auto state = way < 0 ? State::I : caches[i]->mesi_state(0, way);
            assert(state == step.state[i]);
            assert(caches[i]->bus_requests == uint64_t(step.requests[i]));
        }
    $;
while ($step_index < 10$) end do;

// Both writers have S. Core 0 wins this tie. Core 1 retries with BusRdX.
$core.data_cache.write = core1.data_cache.write = 1;
core.data_cache.write_data = 401;
core1.data_cache.write_data = 402;
core.data_cache.request_id++;
core1.data_cache.request_id++;$;
wait until ($core.data_cache.request_id == core.data_cache.response_id &&
             core1.data_cache.request_id == core1.data_cache.response_id$);
$assert(core.data_cache.find_way(44) < 0);
assert(core1.data_cache.mesi_state(0, core1.data_cache.find_way(44)) == State::M);
assert(core1.data_cache.read_data == 402 && data_memory.words[11] == 401);
assert(core1.data_cache.bus_request.op == Cache<>::BusRdX);
// Two simultaneous cold reads must finish with two shared copies.
core.data_cache.address = core1.data_cache.address = 0;
core.data_cache.write = core1.data_cache.write = 0;
core.data_cache.request_id++;
core1.data_cache.request_id++;$;
wait until ($core.data_cache.request_id == core.data_cache.response_id &&
             core1.data_cache.request_id == core1.data_cache.response_id$);
$assert(core.data_cache.is_shared(0) && core1.data_cache.is_shared(0));
assert(core.data_cache.peer_state == State::I && core1.data_cache.peer_state == State::E);

// A write miss must also revoke a clean exclusive copy.
core.data_cache.address = 16;
core.data_cache.request_id++;$;
wait until ($core.data_cache.request_id == core.data_cache.response_id$);
$assert(core.data_cache.mesi_state(1, core.data_cache.find_way(16)) == State::E);
core1.data_cache.address = 16;
core1.data_cache.write = 1;
core1.data_cache.request_id++;$;
wait until ($core1.data_cache.request_id == core1.data_cache.response_id$);
$assert(core.data_cache.find_way(16) < 0);
assert(core1.data_cache.mesi_state(1, core1.data_cache.find_way(16)) == State::M);
initial_writebacks = core.data_cache.writebacks;$;

// Keep the shared line at address 0 in the other set throughout.
do
    $
        const int* access = evictions[eviction_index];
        auto& cache = access[0] ? core1.data_cache : core.data_cache;
        cache.address = access[1];
        cache.write = access[2];
        cache.write_data = access[3];
        cache.request_id++;
    $;
    wait until ($core.data_cache.request_id == core.data_cache.response_id &&
                 core1.data_cache.request_id == core1.data_cache.response_id$);
    $
        auto& cache = core.data_cache;
        assert(cache.is_shared(0));
        assert(cache.writebacks == initial_writebacks + (eviction_index >= 5));
        switch (eviction_index) {
        case 2:
            invalidated_way = cache.find_way(80);
            assert(cache.mesi_state(1, invalidated_way) == State::E);
            break;
        case 3:
            assert(cache.mesi_state(1, invalidated_way) == State::I);
            break;
        case 4: // I: reuse the invalid way, preserving the older modified line.
            assert(cache.find_way(112) == invalidated_way);
            assert(cache.mesi_state(1, invalidated_way) == State::E);
            assert(cache.mesi_state(1, cache.find_way(48)) == State::M);
            assert(data_memory.words[12] == 12 && data_memory.words[13] == 13);
            break;
        case 5: // M: both changed words reach memory before the way is reused.
            assert(cache.find_way(48) < 0);
            assert(data_memory.words[12] == 701 && data_memory.words[13] == 702);
            assert(cache.mesi_state(1, cache.find_way(144)) == State::E);
            break;
        case 6: // E: discard the clean line.
            assert(cache.find_way(112) < 0 && cache.find_way(176) == invalidated_way);
            break;
        case 7:
            assert(cache.is_shared(144) && core1.data_cache.is_shared(144));
            break;
        case 8: // S: discard only this core's copy.
            assert(cache.find_way(144) < 0 && core1.data_cache.is_shared(144));
            assert(cache.mesi_state(1, cache.find_way(208)) == State::E);
            break;
        }
        eviction_index++;
    $;
while ($eviction_index < 9$) end do;
$log << endl << "PASS snoop";$;
